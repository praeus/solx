{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@solx/http": ["../../js/packages/http/src/index.ts"],
      "@solx/surface": ["../../js/packages/surface/src/index.ts"],
      "@solx/tauri": ["../../js/packages/tauri/src/index.ts"],
      "@solx/widgets/host": ["../../js/packages/widgets/src/host/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
