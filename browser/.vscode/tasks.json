{
  "version": "2.0.0",
  "tasks": [
    {
      // solx-web's Vite dev server on :5173 (strictPort) — the app's devUrl.
      // Stays running in the background across debug sessions.
      "label": "solx-browser: ui dev",
      "type": "shell",
      "command": "node scripts/ui-dev.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activesBeginsPattern": "VITE",
          "beginsPattern": "VITE",
          "endsPattern": "ready in|Local:"
        }
      }
    },
    {
      "label": "solx-browser: server build",
      "type": "cargo",
      "command": "build",
      "options": { "cwd": "${workspaceFolder}/src-tauri" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "solx-browser: client build",
      "type": "cargo",
      "command": "build",
      "args": ["--no-default-features", "--features", "client"],
      "options": { "cwd": "${workspaceFolder}/src-tauri" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "solx-browser: server prepare",
      "dependsOn": ["solx-browser: ui dev", "solx-browser: server build"]
    },
    {
      "label": "solx-browser: client prepare",
      "dependsOn": ["solx-browser: ui dev", "solx-browser: client build"]
    }
  ]
}
