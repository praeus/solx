{
  // Debug configs build the app with cargo (no `tauri` CLI), so the webview
  // loads `devUrl` from the solx-web dev server started by the
  // "solx-browser: ui dev" task. The "tauri dev" configs start their own dev
  // server instead (tauri.conf.json's beforeDevCommand), so stop that task
  // first or they'll fail with "Port 5173 is already in use".
  // Uses the MSVC debugger (ms-vscode.cpptools) — the right one for a
  // Windows MSVC build.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "solx-browser - debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src-tauri/target/debug/solx-explorer.exe",
      "cwd": "${workspaceFolder}/src-tauri",
      "console": "integratedTerminal",
      "preLaunchTask": "solx-browser: server prepare"
    },
    {
      "name": "solx-browser - tauri dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "solx-browser (client) - debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src-tauri/target/debug/solx-explorer.exe",
      "cwd": "${workspaceFolder}/src-tauri",
      "console": "integratedTerminal",
      "preLaunchTask": "solx-browser: client prepare"
    },
    {
      "name": "solx-browser (client) - tauri dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:client",
      "cwd": "${workspaceFolder}"
    }
  ]
}
