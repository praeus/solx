{
  // File nesting groups related generated files under the source files
  // that produced them so the explorer tree stays tidy.
  "files.nesting": {
    "enabled": true,
    "patterns": {
      "package.json": ".env, .env.local, .gitignore, bun.lock, tsconfig.json, vite.config.ts",
      "*.ts": "${capture}.d.ts, ${capture}.test.ts, ${capture}.tsx",
      "*.tsx": "${capture}.test.tsx"
    }
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/vendor": true,
    "**/target": true
  },

  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },

  "typescript.tsdk": "web/web/node_modules/typescript/lib",

  // Hide vendor and build output from the explorer
  "files.exclude": {
    "**/server/vendor": true,
    "**/web/dist": true,
    "**/.turbo": true
  }
}
