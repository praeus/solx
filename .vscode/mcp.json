{
  "inputs": [
    {
      "type": "promptString",
      "id": "solxServerToken",
      "description": "solx-server bearer token (run `solx token show`)",
      "password": true
    }
  ],
  "servers": {
    "solx": {
      "type": "http",
      "url": "http://127.0.0.1:8766/mcp",
      "headers": {
        "Authorization": "Bearer ${input:solxServerToken}"
      }
    }
  }
}
